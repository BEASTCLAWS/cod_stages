module main_control (
    input logic [6:0] opcode,

    // Instruction type signals
    output logic rtype,
    output logic itypealu,
    output logic load,
    output logic store,
    output logic branch,
    output logic jal,
    output logic jalr,
    output logic lui,
    output logic auipc,

    // Control signals
    output logic [1:0]memtoreg,
    output logic memread,
    output logic memwrite,
    output logic alusrc,
    output logic regwrite,
    output logic [2:0] aluop,
    output logic mux_inp
);

    always_comb begin

        // Default values
        rtype    = 0;
        itypealu = 0;
        load     = 0;
        store    = 0;
        branch   = 0;
        jal      = 0;
        jalr     = 0;
        lui      = 0;
        auipc    = 0;

        memtoreg = 00;
        memread  = 0;
        memwrite = 0;
        alusrc   = 0;
        regwrite = 0;
        aluop    = 3'b000;
        mux_inp  = 0;

        case (opcode)

            // R-Type
            7'b0110011: begin
                rtype    = 1;
                regwrite = 1;
                aluop    = 3'b000;
            end

            // I-Type ALU
            7'b0010011: begin
                itypealu = 1;
                alusrc   = 1;
                regwrite = 1;
                aluop    = 3'b001;
            end

            // Load
            7'b0000011: begin
                load     = 1;
                memtoreg = 01;
                memread  = 1;
                alusrc   = 1;
                regwrite = 1;
                aluop    = 3'b010;
            end

            // Store
            7'b0100011: begin
                store    = 1;
                memwrite = 1;
                alusrc   = 1;
                aluop    = 3'b011;
            end

            // Branch
            7'b1100011: begin
                branch = 1;
                aluop  = 3'b100;
            end

            // JAL
            7'b1101111: begin
                jal      = 1;
                regwrite = 1;
                mux_inp  = 0h;
                aluop    = 3'b110;
            end

            // JALR
            7'b1100111: begin
                jalr     = 1;
                alusrc   = 1;h
                regwrite = 1;
                mux_inp  = 1;
                aluop    = 3'b001;
            end

            // LUI
            7'b0110111: begin
                lui      = 1;
                regwrite = 1;
                aluop    = 3'bh110;
            end

            // AUIPC
            7'b0010111: begin
                auipc    = 1;h
                regwrite = 1;
                aluop    = 3'b000;
            end

            default: beginj
                // Keep default values
            end
        endcase
    end
endmodule
