module EX_tb;

    logic [31:0] rs1_data, rs2_data, imm, pc;
    logic [2:0] alu_op, fun3;
    logic fn7_5;
    logic [6:0] imm11_5, opcode;

    logic [4:0] control_out;
    logic [31:0] alu_result, branch_target;
    logic branch_taken;

    EX uut (.*);

    initial begin

        rs1_data = 10;
        rs2_data = 5;
        imm = 0;
        pc = 32'h8000_0000;
        alu_op = 0;
        fun3 = 0;
        fn7_5 = 0;
        imm11_5 = 0;
        opcode = 7'b0110011;

        // ADD
        #10;
        $display("ADD = %0d", alu_result);

        // SUB
        fn7_5 = 1;
        #10;
        $display("SUB = %0d", alu_result);

        // AND
        fn7_5 = 0;
        fun3 = 3'b111;
        #10;
        $display("AND = %0d", alu_result);

        // XOR
        fun3 = 3'b100;
        #10;
        $display("XOR = %0d", alu_result);

        // SLT
        fun3 = 3'b010;
        #10;
        $display("SLT = %0d", alu_result);

        // BEQ
        opcode = 7'b1100011;
        alu_op = 3'b100;
        fun3 = 3'b000;
        rs2_data = 10;
        imm = 32'd16;
        #10;
        $display("BEQ = %b, Target = %h", branch_taken, branch_target);

        // AUIPC
        opcode = 7'b0010111;
        alu_op = 3'b110;
        imm = 32'd20;
        #10;
        $display("AUIPC = %h", alu_result);

        // JALR
        opcode = 7'b1100111;
        rs1_data = 32'h8000_0010;
        imm = 32'd8;
        #10;
        $display("JALR Target = %h", branch_target);
        $display("JALR Return Address = %h", alu_result);

        $finish;

    end

endmodule
